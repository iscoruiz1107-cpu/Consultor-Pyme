# Copiá este archivo a ".env" y completá tu clave real.
# Conseguí tu API key gratis en https://console.groq.com/keys
GROQ_API_KEY=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

# Modelo de texto con búsqueda web incorporada (no hace falta tocarlo).
GROQ_TEXT_MODEL=groq/compound

# Modelo con visión, usado automáticamente cuando el usuario adjunta una
# imagen. meta-llama/llama-4-scout-17b-16e-instruct es una alternativa
# más rápida y económica si preferís priorizar velocidad sobre calidad.
GROQ_VISION_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

PORT=3000
